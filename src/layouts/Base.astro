---
import '../styles/global.css';
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = '구매 전 확인할 기준',
  description = site.description,
  noindex = false,
} = Astro.props;
const pageTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const robots = !site.indexingEnabled || noindex ? 'noindex, follow' : 'index, follow';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8f5" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="naver-site-verification" content="84cf9dd15c0a888f0516823fa7a1908e157c4d7f" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a href="#main" class="skip-link">본문으로 건너뛰기</a>
    <div class="topline"><div class="container">검증 가능한 근거를 바탕으로 고르는 생활용품 가이드</div></div>
    <header class="site-header">
      <div class="container top">
        <a class="logo" href="/" aria-label="GuideHollow Pick 홈페이지">
          <span class="logo__mark" aria-hidden="true">G<span>·</span>P</span>
          <span class="logo__type">GUIDEHOLLOW <strong>PICK</strong><small>구매 전 비교 가이드</small></span>
        </a>
        <nav class="main-nav" aria-label="주요 메뉴">
          <a href="/" aria-current={path==='/' ? 'page' : undefined}>홈</a>
          <a href="/category/appliances/" aria-current={path.startsWith('/category/appliances/') ? 'page' : undefined}>생활가전</a>
          <a href="/category/cleaning/" aria-current={path.startsWith('/category/cleaning/') ? 'page' : undefined}>청소·관리</a>
          <a href="/category/kitchen/" aria-current={path.startsWith('/category/kitchen/') ? 'page' : undefined}>주방·살림</a>
          <a href="/about/" aria-current={path==='/about/' ? 'page' : undefined}>소개</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-main">
        <div>
          <div class="footer-title">GUIDEHOLLOW <span>PICK</span></div>
          <p>정확한 모델과 사용 환경부터 확인합니다.<br />검증되지 않은 제품은 추천하지 않습니다.</p>
        </div>
        <nav class="footer-links" aria-label="사이트 정보">
          <a href="/about/">작성·검수 원칙</a>
          <a href="/disclosure/">광고·제휴 고지</a>
          <a href="/privacy/">개인정보 안내</a>
          <a href="https://guidehollow.com/" rel="noopener noreferrer">GuideHollow 본사이트</a>
        </nav>
      </div>
      <div class="container footer-bottom">© 2026 GuideHollow Pick · 구매 전 비교 가이드</div>
    </footer>
  </body>
</html>
