---
import Base from '../../layouts/Base.astro';
import { categories } from '../../data/categories';
import { getPublishedGuides } from '../../lib/guides';
export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.id }, props: { category } }));
}
const { category } = Astro.props;
const guides = (await getPublishedGuides()).filter((g) => g.data.category === category.id);
---
<Base title={category.title} description={category.description}>
  <div class="container prose">
    <span class="eyebrow">{category.eyebrow}</span>
    <h1>{category.headline}</h1>
    <p class="lead">{category.description}</p>
    {guides.length === 0 ? (
      <p class="note">공식 자료 검수가 완료된 글부터 순차적으로 공개합니다.</p>
    ) : (
      <div class="list">
        {guides.map((guide) => (
          <a class="list-item" href={`/guides/${guide.id}/`}>
            <h3>{guide.data.title}</h3>
            <p>{guide.data.description}</p>
          </a>
        ))}
      </div>
    )}
  </div>
</Base>
