---
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import { categories } from '../../data/categories';
import { getPublishedGuides } from '../../lib/guides';
export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.id }, props: { category } }));
}
const { category } = Astro.props;
const guides = (await getPublishedGuides()).filter((guide) => guide.data.category === category.id);
---
<Base title={category.title} description={category.description}>
  <div class="container">
    <header class="page-intro">
      <div class="breadcrumb"><a href="/">홈</a><span aria-hidden="true">/</span><span>{category.title}</span></div>
      <span class="eyebrow">제품 유형별 구매 가이드</span>
      <h1>{category.headline}</h1>
      <p class="lead">{category.description}</p>
    </header>
    <nav class="category-tabs" aria-label="다른 상품 분야">
      {categories.map((item) => (
        <a href={`/category/${item.id}/`} aria-current={category.id===item.id ? 'page' : undefined}>{item.title}</a>
      ))}
    </nav>
    <section class="section category-results" aria-labelledby="category-guide-title">
      <div class="section-head">
        <div>
          <span class="section-kicker">BUYING GUIDES</span>
          <h2 id="category-guide-title">{category.title} 구매 가이드</h2>
          <p>비교 근거를 확인한 콘텐츠를 발행일 순서로 소개합니다.</p>
        </div>
        <span class="result-count">{guides.length}개 글</span>
      </div>
      {guides.length > 0 ? (
        <div class="guide-grid">
          {guides.map((guide) => <GuideCard guide={guide}/>)}
        </div>
      ) : (
        <div class="empty-state">
          <h3>아직 공개된 가이드가 없습니다</h3>
          <p>확인되지 않은 제품 순위나 가격 대신, 검증된 정보가 준비되면 이곳에 공개합니다.</p>
          <a class="text-link" href="/#categories">다른 카테고리 둘러보기 <span aria-hidden="true">→</span></a>
        </div>
      )}
    </section>
  </div>
</Base>
