---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPublishedGuides } from '../../lib/guides';
export async function getStaticPaths() {
  const entries = await getPublishedGuides();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.publishedDate.toISOString().slice(0, 10);
const disclosure = '이 글에는 쿠팡파트너스 제휴 링크가 포함될 수 있으며, 해당 링크를 통한 구매 시 일정액의 수수료를 제공받을 수 있습니다.';
---
<Base title={entry.data.title} description={entry.data.description}>
  <article class="container prose">
    {entry.data.affiliate && (
      <p class="note" role="note"><strong>[광고/제휴 고지]</strong> {disclosure}</p>
    )}
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
    <p class="meta">발행 {date}{entry.data.updatedDate ? ` · 갱신 ${entry.data.updatedDate.toISOString().slice(0,10)}` : ''}</p>
    <Content />
    {entry.data.sources.length > 0 && (
      <section aria-labelledby="sources-title">
        <h2 id="sources-title">자료 및 출처</h2>
        <ul>
          {entry.data.sources.map((source) => (
            <li><a href={source} rel="noopener noreferrer" target="_blank">{source}</a></li>
          ))}
        </ul>
      </section>
    )}
    <p class="disclosure">제품 사양과 판매 조건은 변경될 수 있습니다. 구매 전 공식 판매 페이지에서 최신 정보를 확인하세요.</p>
  </article>
</Base>
