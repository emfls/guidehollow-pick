---
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import { categories } from '../data/categories';
import { getPublishedGuides } from '../lib/guides';
const guides = await getPublishedGuides();
const featured = guides[0];
const others = guides.slice(1,6);
---
<Base title="구매 전 확인할 기준">
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span> 직접 확인할 수 있는 정보부터</span>
        <h1 id="hero-title">사기 전에,<br /><em>중요한 기준부터</em><br />확인하세요.</h1>
        <p class="lead">광고 문구에 흔들리지 않도록. <strong>성능, 관리 비용, 안전성, 실제 사용 조건</strong>을 비교해 합리적으로 고를 수 있게 돕습니다.</p>
        <div class="hero-actions">
          <a class="button-link primary" href="#latest">최근 구매 가이드 보기 <span aria-hidden="true">→</span></a>
          <a class="button-link secondary" href="#categories">카테고리 살펴보기</a>
        </div>
        <p class="hero__promise">제휴 링크보다 제품 검증이 먼저입니다</p>
      </div>
      <aside class="hero-panel" aria-label="구매 전 점검 항목">
        <div class="hero-panel__top"><span class="hero-panel__label">구매 전 점검 항목</span><span class="hero-panel__pill">3가지 기준</span></div>
        <h2>이 세 가지부터 확인하세요</h2>
        <ol class="decision-list">
          <li><span aria-hidden="true">01</span><div><strong>내 환경에 맞는가</strong><small>공간 · 사용 빈도 · 크기와 용량</small></div></li>
          <li><span aria-hidden="true">02</span><div><strong>사용 후 부담은 없는가</strong><small>세척 · 소모품 · 유지 비용</small></div></li>
          <li><span aria-hidden="true">03</span><div><strong>믿을 근거가 있는가</strong><small>공식 사양 · 독립 평가 · 단점</small></div></li>
        </ol>
        <p class="hero-panel__foot">검증이 부족하면 제품을 추천하지 않습니다</p>
      </aside>
    </section>
    <section class="section section--latest" id="latest" aria-labelledby="latest-title">
      <div class="section-head">
        <div>
          <span class="section-kicker">READ FIRST</span>
          <h2 id="latest-title">먼저 읽어볼 구매 가이드</h2>
          <p>필요한 정보를 빠르게 확인하고, 구매 전 체크할 기준을 정리하세요.</p>
        </div>
      </div>
      {featured ? (
        <>
          <GuideCard guide={featured} featured={true}/>
          {others.length > 0 && (
            <div class="guide-grid" aria-label="다른 구매 가이드">
              {others.map((guide) => <GuideCard guide={guide} />)}
            </div>
          )}
        </>
      ) : (
        <div class="empty-state">
          <h3>첫 비교 가이드를 준비하고 있습니다</h3>
          <p>공식 자료와 실제 제품 조건을 검증한 글만 공개합니다. 아직 확인되지 않은 제품의 구매 링크는 소개하지 않습니다.</p>
          <a href="/about/" class="text-link">검수 기준 확인 <span aria-hidden="true">→</span></a>
        </div>
      )}
    </section>
    <section class="section" id="categories" aria-labelledby="categories-title">
      <div class="section-head">
        <div>
          <span class="section-kicker">EXPLORE BY CATEGORY</span>
          <h2 id="categories-title">어떤 제품을 찾고 있나요?</h2>
          <p>필요한 용도에 맞춰 정보를 찾아보세요.</p>
        </div>
      </div>
      <div class="category-grid">
        {categories.map((category,index) => (
          <a class="category-card" href={`/category/${category.id}/`}>
            <span class="category-card__number">0{index+1}</span>
            <span class="category-card__title">{category.title}</span>
            <span class="category-card__desc">{category.description}</span>
            <span class="category-card__action">가이드 살펴보기 <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </section>
    <section class="section" aria-labelledby="principles-title">
      <div class="method">
        <div class="section-head">
          <div>
            <span class="section-kicker">OUR REVIEW STANDARD</span>
            <h2 id="principles-title">추천에 앞서 검증합니다</h2>
            <p>제품을 먼저 검증하고 그다음에 필요한 구매 링크를 연결합니다.</p>
          </div>
          <a class="text-link" href="/about/">편집 원칙 자세히 보기 <span aria-hidden="true">→</span></a>
        </div>
        <ol class="review-steps">
          <li><span class="review-steps__num">01</span><strong>선택 기준 정의</strong><p>사용 환경과 필요한 기능을 먼저 정합니다.</p></li>
          <li><span class="review-steps__num">02</span><strong>출처 확인</strong><p>제조사 공식 정보와 외부 시험 자료를 살핍니다.</p></li>
          <li><span class="review-steps__num">03</span><strong>장점·단점 비교</strong><p>누구에게 맞고 누구에게 맞지 않는지 구분합니다.</p></li>
          <li><span class="review-steps__num">04</span><strong>제품 링크 연결</strong><p>모델과 옵션이 일치할 때만 제휴 링크를 붙입니다.</p></li>
        </ol>
      </div>
    </section>
    <section class="closing-note" aria-labelledby="disclosure-title">
      <div>
        <span class="section-kicker">TRANSPARENCY</span>
        <h2 id="disclosure-title">광고 여부는 명확하게 알립니다</h2>
        <p>일부 글에 제휴 링크가 포함될 수 있습니다. 해당 글 첫 부분에서 경제적 이해관계를 안내하며, 추천 근거와 공식 출처도 함께 제공합니다.</p>
      </div>
      <a class="button-link secondary" href="/disclosure/">광고·제휴 안내</a>
    </section>
  </div>
</Base>
